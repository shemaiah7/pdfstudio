{
  "manifest_version": 3,
  "name": "SentinelPDF — open PDFs in SentinelPDF",
  "short_name": "SentinelPDF",
  "version": "1.0.0",
  "description": "Open PDFs from the web in SentinelPDF instead of the browser's built-in viewer. Nothing is uploaded; the PDF stays in your browser.",
  "minimum_chrome_version": "110",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "SentinelPDF",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://sentinelpdf.com/*", "https://www.sentinelpdf.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["declarativeNetRequest", "storage", "contextMenus", "tabs"],
  "host_permissions": ["<all_urls>"]
}
