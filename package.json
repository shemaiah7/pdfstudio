{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "tsx scripts/make-fixtures.ts",
    "fixtures:jbig2": "python3 scripts/make-jbig2-fixture.py",
    "e2e": "playwright test",
    "search:smoke": "tsx scripts/search-smoke.ts",
    "lint": "oxlint",
    "worker:dev": "npm --prefix worker run dev",
    "worker:test": "npm --prefix worker test",
    "worker:deploy": "npm --prefix worker run deploy",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.10",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@elevenlabs/client": "1.27.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@huggingface/transformers": "^4.3.1",
    "idb": "^8.0.4",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tesseract.js": "^7.0.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
