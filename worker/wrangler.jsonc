{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pdfstudio-ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "dev": { "port": 8797, "inspector_port": 9311 },
  "kv_namespaces": [{ "binding": "QUOTA", "id": "placeholder-replace-before-deploy" }],
  "vars": {
    "ALLOWED_ORIGIN": "http://localhost:5173,http://localhost:5174,http://localhost:5175",
    "TURNSTILE_HOSTNAMES": "localhost,example.com"
  }
}
